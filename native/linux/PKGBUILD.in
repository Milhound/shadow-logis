# SPDX-License-Identifier: AGPL-3.0-only
# Generated with the source ZIP checksum by tools/build-arch.sh.
pkgname=shadow-logis
pkgver=@VERSION@
pkgrel=1
pkgdesc='Native shipping workspaces and documents with optional legacy TPS import'
arch=('x86_64')
url='https://github.com/Milhound/shadow-logis'
license=('AGPL-3.0-only' 'Apache-2.0' 'OFL-1.1' 'ODbL-1.0' 'LicenseRef-DbCL-1.0')
depends=('glibc' 'gcc-libs' 'qt6-base' 'qt6-webengine' 'qt6-wayland' 'ttf-liberation')
makedepends=('cmake' 'ninja' 'python')
checkdepends=('poppler' 'fontconfig')
options=('!debug' '!lto')
source=('shadow-logis-source.zip')
sha256sums=('@SOURCE_SHA256@')

build() {
    cmake -S "$srcdir/shadow-logis" -B "$srcdir/build" -G Ninja \
        -DCMAKE_BUILD_TYPE=Release -DCMAKE_INSTALL_PREFIX=/usr \
        -DCMAKE_INSTALL_LIBDIR=lib -DBUILD_TESTING=ON \
        -DSHADOW_LOGIS_DISTRO_ID=arch
    cmake --build "$srcdir/build" --parallel "${CMAKE_BUILD_PARALLEL_LEVEL:-4}"
}

check() {
    ctest --test-dir "$srcdir/build" --output-on-failure --parallel 2
}

package() {
    DESTDIR="$pkgdir" cmake --install "$srcdir/build"
    python "$srcdir/shadow-logis/tools/verify_linux_package.py" "$pkgdir/usr"
}
